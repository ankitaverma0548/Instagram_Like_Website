<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Post</title>
</head>
<body>
    <h2>Edit your post</h2>
    <p>Post id : <%= post.id %></p>
    <p>Post username : <%= post.username%></p>
    <form method="post" action="/posts/<%=post.id%>?_method=PATCH">
        <input placeholder="Edit your pic" type="url" name="image" id="photolink">
        <br><br>
        <input placeholder="Edit your caption" type="text" name="caption">
        <br><br>
        <button>Submit</button>
    </form>
</body>
</html>